# Copy to .env and adjust. Values here target local host-based dev; docker-compose
# overrides the DB and S3 endpoints to the in-network service names.

REFMAN_APP_BASE_URL=http://localhost:8000
REFMAN_CORS_ORIGINS=["http://localhost:5173"]

# Database
REFMAN_DATABASE_URL=postgresql+asyncpg://refman:refman@localhost:5432/refman

# Object storage (SeaweedFS S3). PUBLIC endpoint is what the browser uses for signed URLs.
REFMAN_S3_ENDPOINT_URL=http://localhost:8333
REFMAN_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
REFMAN_S3_ACCESS_KEY=refman
REFMAN_S3_SECRET_KEY=refman-secret
REFMAN_S3_BUCKET=refman-pdfs
REFMAN_PRESIGN_EXPIRY_SECONDS=900

# Sessions — generate a strong random value in production
REFMAN_SESSION_SECRET=dev-only-change-me

# Auth: dev bypass on for local development. In production set false + configure OIDC.
REFMAN_DEV_AUTH=true
REFMAN_DEV_USER_EMAIL=dev@e4e.local
REFMAN_DEV_USER_NAME=Dev User

# Authentik OIDC (used when REFMAN_DEV_AUTH=false)
REFMAN_OIDC_ISSUER=
REFMAN_OIDC_CLIENT_ID=
REFMAN_OIDC_CLIENT_SECRET=
REFMAN_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
REFMAN_POST_LOGIN_REDIRECT=http://localhost:5173
